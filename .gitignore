# Local configuration files (privacy/security)
config/*.local.yaml
config/*.local.windows.yaml
config/*.local.linux.yaml
config.local.yaml

# Tool session data
.kimi/
.claude/

# IDE / editor MCP configuration
.idea/
.vscode/
.serena/
*.swp

# Virtual environments
venv/
.env/
.venv/

# Python packaging
*.egg-info/
dist/
build/

# Logs
*.log

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Output data (figures and results)
figures/
ops/

# Temporary folders
temp/
tmp/

# Backup files (keep local only)
*.bak

# Temporary files (keep local only)
_*.py
_*.txt
_*.csv
_*.npy
# Dunder files are standard Python module files (__init__.py, __main__.py),
# not temporary ones. This must stay AFTER _*.py or the exemption is ignored.
!__*__.py

# Local-only documentation (not for upload)
docs/OPERATIONAL_INFERENCE_PIPELINE_cn.md

# Model registry data (large binaries, keep local only)
model/

# Proprietary documents, raw data and archives.
# Cline checkpoints stash untracked-but-not-ignored files into git objects,
# so anything listed here also stays out of the object database.
# Use "git add -f <file>" when a sample of these must be tracked on purpose.
*.docx
*.doc
*.pdf
*.npy
*.npz
*.csv
*.xls
*.xlsx
*.ppt
*.pptx
*.rar
*.zip
*.7z

# Plot outputs and images. "figures*/" also covers the legacy "figures-" dir,
# which the plain "figures/" rule above does not match.
figures*/
*.tif
*.tiff
*.jpg
*.jpeg
*.eps
*.png
*.svg
